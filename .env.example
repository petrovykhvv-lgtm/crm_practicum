# Скопируйте в .env: cp .env.example .env
# Значение по умолчанию подходит для PostgreSQL из docker-compose.yml (порт 5433).
# Локальные учебные данные, не используйте их нигде, кроме своей машины.
DATABASE_URL="postgresql://crm:crm_local_password@localhost:5433/crm_practicum?schema=public"

# Часовой пояс для границ «сегодня», недель и месяцев (дашборд, задачи, сроки).
# Не задан: используется часовой пояс сервера.
APP_TIMEZONE="Europe/Moscow"

# Необязательно: тестовая база для `npm test`. Имя обязано оканчиваться на _test, тесты очищают её таблицы.
# Не задано: берётся имя из DATABASE_URL с суффиксом _test (crm_practicum_test).
# DATABASE_URL_TEST="postgresql://crm:crm_local_password@localhost:5433/crm_practicum_test?schema=public"
